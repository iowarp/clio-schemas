{
  "name": "clio-schemas-ts-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic TypeScript generator for clio-schemas JSON Schema exports.",
  "scripts": {
    "generate": "node schemas-to-ts.mjs --in ../../src/clio_schemas/schemas --out ../../generated-ts",
    "check": "node schemas-to-ts.mjs --in ../../src/clio_schemas/schemas --out ../../generated-ts && tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "json-schema-to-typescript": "15.0.4"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
