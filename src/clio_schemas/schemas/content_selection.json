{
  "$defs": {
    "ImageSelection": {
      "additionalProperties": false,
      "description": "Normalized image coordinates, independent of display size.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "kind": {
          "const": "image_region",
          "default": "image_region",
          "title": "Kind",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ImageSelection",
      "type": "object"
    },
    "StructuredSelection": {
      "additionalProperties": false,
      "description": "Stable A2UI component and source keys, never inferred from display order.",
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Keys",
          "type": "array"
        },
        "kind": {
          "const": "structured",
          "default": "structured",
          "title": "Kind",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "surface_id": {
          "minLength": 1,
          "title": "Surface Id",
          "type": "string"
        }
      },
      "required": [
        "surface_id",
        "component_id",
        "source_ref",
        "keys"
      ],
      "title": "StructuredSelection",
      "type": "object"
    },
    "TextSelection": {
      "additionalProperties": false,
      "description": "Character offsets within an identified content part, using Unicode code points.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TextSelection",
      "type": "object"
    },
    "WholeSelection": {
      "additionalProperties": false,
      "description": "The whole identified block or artifact.",
      "properties": {
        "kind": {
          "const": "whole",
          "default": "whole",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "WholeSelection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An inspectable transcript reference with revision-bound selection coordinates.",
  "properties": {
    "artifact_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Ref"
    },
    "call_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Call Id"
    },
    "content_revision": {
      "minLength": 1,
      "title": "Content Revision",
      "type": "string"
    },
    "message_id": {
      "minLength": 1,
      "title": "Message Id",
      "type": "string"
    },
    "part_id": {
      "minLength": 1,
      "title": "Part Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "selection": {
      "discriminator": {
        "mapping": {
          "image_region": "#/$defs/ImageSelection",
          "structured": "#/$defs/StructuredSelection",
          "text": "#/$defs/TextSelection",
          "whole": "#/$defs/WholeSelection"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextSelection"
        },
        {
          "$ref": "#/$defs/WholeSelection"
        },
        {
          "$ref": "#/$defs/ImageSelection"
        },
        {
          "$ref": "#/$defs/StructuredSelection"
        }
      ],
      "title": "Selection"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "message_id",
    "part_id",
    "content_revision",
    "selection"
  ],
  "title": "ContentSelection",
  "type": "object"
}
