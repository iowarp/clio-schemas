    "InjectionMessageBlock": {
      "additionalProperties": false,
      "description": "Data the harness (CLIO) gave the agent: a plan reminder, the todo list, a path\nsuggestion, a saved oversize result, a hook's effect. ``source`` names what it is;\n``text`` is exactly what the agent got; ``call_id`` ties a note to its tool call.\n\n``source: \"summarization\"`` is a compaction's record: ``text`` is the summary the\nagent continues from, ``trigger`` says who asked for it (``auto`` or ``manual``)\nand ``compaction_id`` names that compaction. ``variants_id`` / ``try_index`` mean\nthe block belongs to that variant try's tab (e.g. Refine advice given inside a try).",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "call_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Call Id"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "compaction_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compaction Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "stream_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Source"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "manual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger"
        },
        "try_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Try Index"
        },
        "type": {
          "const": "injection",
          "title": "Type",
          "type": "string"
        },
        "variants_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variants Id"
        }
      },
      "required": [
        "id",
        "type",
        "source",
        "text"
      ],
      "title": "InjectionMessageBlock",
      "type": "object"
    },
    "NoticeMessageBlock": {
      "additionalProperties": false,
